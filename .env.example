# Copy this file to .env before running `docker compose up --build`.
# Never commit the real .env file.

# --- PostgreSQL ---
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=change_me

# DATABASE_URL is assembled automatically by docker-compose.yml from the
# POSTGRES_* variables above. Set it explicitly only if you're running the
# backend outside of Docker Compose.
DATABASE_URL=

# --- Backend / JWT ---
ENVIRONMENT=development
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# --- Frontend ---
# Baked into the frontend build at image build time (static SPA).
VITE_API_URL=http://localhost:8000
