# Backend environment variables (copy to .env for local, non-Docker runs)

ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://taskflow_user:taskflow_password@localhost:5432/taskflow

# JWT
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
